# Required for AWorld agent tasks. Fill these at runtime; do not commit real values.
LLM_PROVIDER=openai
LLM_MODEL_NAME=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.1

# Optional local media transcription defaults.
FILEX_LOCAL_MEDIA_MODEL=base
FILEX_LOCAL_MEDIA_DEVICE=auto
FILEX_LOCAL_MEDIA_COMPUTE_TYPE=default
