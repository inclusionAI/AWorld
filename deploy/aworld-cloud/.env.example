# This must be an absolute host path. It is mounted at the identical path in
# the worker because Harbor asks the host Docker daemon to bind-mount task data.
AWORLD_CLOUD_DATA_DIR=/var/tmp/aworld-cloud

# Optional explicit daemon-visible socket bind source. The init/verify scripts
# validate candidates with a short container connection check when this is
# unset. Colima and Docker Desktop commonly use /var/run/docker.sock here even
# when the host Docker context reports a socket below the user's home directory.
# AWORLD_CLOUD_DOCKER_SOCKET=/var/run/docker.sock

AWORLD_CLOUD_IMAGE=aworld-cloud-mvp:local
AWORLD_CLOUD_PORT=8000
AWORLD_CLOUD_PROFILE=terminal-bench
AWORLD_CLOUD_RUNTIME_USER=root
AWORLD_CLOUD_RUN_NETWORK=bridge
AWORLD_CLOUD_RUN_TIMEOUT_SECONDS=1800
