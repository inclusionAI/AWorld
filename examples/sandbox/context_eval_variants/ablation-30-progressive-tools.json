{
  "schema_version": "aworld.context-eval-variant/v1",
  "name": "ablation-30-progressive-tools",
  "agent_memory_config": {
    "tool_result_offload": true,
    "tool_result_length_threshold": 4096,
    "tool_result_preview_chars": 2000
  },
  "context_compiler": {
    "mode": "enforce",
    "compiler_version": "v1",
    "policy_version": "v1",
    "universal_final": true,
    "require_proven_semantics_for_enforce": true,
    "scoped_instructions": "nested",
    "progressive_skills": false,
    "progressive_tools": true,
    "progressive_tool_base_tools": [
      "run_code",
      "read_output_artifact",
      "read_file",
      "write_file",
      "edit_file",
      "list_directory",
      "search_content",
      "search_files",
      "create_directory",
      "move_file"
    ],
    "progressive_tool_unmanaged_policy": "preserve",
    "task_catalog_policy": "sticky",
    "checkpoint_policy": "explicit",
    "destructive_sandbox_checkpoint": false,
    "default_tool_output_inline_tokens": 4096,
    "artifact_offload": true,
    "context_inspector": true,
    "trace_level": "decisions",
    "completion_contract": "off"
  },
  "docker_output_policy": {
    "max_inline_output_bytes": 65536,
    "output_head_bytes": 32768
  }
}
